{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [
      "/Users/phil/Projects/godot-skills/skills"
    ]
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp"
      ],
      "enabled": false
    },
    "next-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "next-devtools-mcp"
      ],
      "enabled": false
    },
    "dash-api": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/Kapeli/dash-mcp-server.git",
        "dash-mcp-server"
      ]
    },
    "blender-mcp": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "/Users/phil/Projects/3D/blender_mcp/mcp",
        "run",
        "blender-mcp"
      ],
      "enabled": true,
      "environment": {
        "BLENDER_MCP_HOST": "localhost",
        "BLENDER_MCP_PORT": "9876"
      }
    }
  }
}
